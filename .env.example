# RefScope Python server — copy to .env and fill in what you have (all optional).
# Shazam (shazamio) needs no key. Set REFSCOPE_SHAZAM=0 to disable it.
REFSCOPE_SHAZAM=1
AUDD_API_TOKEN=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
LASTFM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required whenever the server is reachable from outside your home network.
REFSCOPE_ACCESS_TOKEN=
