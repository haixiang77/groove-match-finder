{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_MCP_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "BASH_MAX_OUTPUT_LENGTH": "30000"
  },
  "enabledMcpjsonServers": ["git", "memory", "playwright"],
  "permissions": {
    "allow": [
      "Bash(python .agent/verifiers/verify.py)",
      "Bash(python .agent/verifiers/verify.py --summary)",
      "Bash(python .agent/verifiers/verify.py --req:*)",
      "Bash(python .agent/verifiers/verify.py --strict)",
      "Bash(python .agent/verifiers/verify.py --harness-only)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/eval-recognition.mjs:*)",
      "mcp__memory__search_nodes",
      "mcp__memory__open_nodes",
      "mcp__git__git_diff",
      "mcp__git__git_log",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(index.html)",
      "Edit(assets/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.agent/hooks/guard_contract.py\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.agent/hooks/guard_contract.py\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.agent/hooks/stop_verify.py\"", "timeout": 900 }
        ]
      }
    ]
  }
}
