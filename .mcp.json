{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."]
    },
    "memory": {
      "command": "sh",
      "args": [
        "-c",
        "MEMORY_FILE_PATH=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agent/state/knowledge_graph.json\" exec npx -y @modelcontextprotocol/server-memory"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    }
  }
}
